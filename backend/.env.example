# Copy to .env (backend/.env for local development). Every value is optional;
# the defaults run LumaPath locally. No secrets or API keys are required:
# all services LumaPath uses are free public APIs.

# Browser origins allowed to call the API (comma-separated).
# Not needed when the API serves the web app itself (the Docker image).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local OpenStreetMap database, built with: python -m geodata.build ...
GEO_DB_PATH=data/kerala_geo.sqlite

# Outside the database's area, fall back to live public Overpass servers.
OVERPASS_FALLBACK=true

# Per-client requests per minute.
RATE_LIMIT_ROUTES_PER_MIN=20
RATE_LIMIT_SEARCH_PER_MIN=90
RATE_LIMIT_REVERSE_PER_MIN=30

# Set to true ONLY behind a reverse proxy (Render, Fly, nginx) so the real
# client address is used for rate limiting.
TRUST_PROXY=false

# Serve the built web app from this folder (set in the Docker image).
# STATIC_DIR=../frontend/dist

LOG_LEVEL=INFO
